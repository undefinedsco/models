{
  "name": "@undefineds.co/models",
  "version": "0.2.24",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undefinedsco/models.git"
  },
  "bugs": {
    "url": "https://github.com/undefinedsco/models/issues"
  },
  "homepage": "https://github.com/undefinedsco/models#readme",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./ai-config": {
      "types": "./src/ai-config/index.ts",
      "node": "./dist/ai-config/index.js",
      "default": "./src/ai-config/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "node": "./dist/client/index.js",
      "default": "./src/client/index.ts"
    },
    "./discovery": {
      "types": "./src/discovery/index.ts",
      "node": "./dist/discovery/index.js",
      "default": "./src/discovery/index.ts"
    },
    "./namespaces": {
      "types": "./src/namespaces.ts",
      "node": "./dist/namespaces.js",
      "default": "./src/namespaces.ts"
    },
    "./profile": {
      "types": "./src/profile.ts",
      "node": "./dist/profile.js",
      "default": "./src/profile.ts"
    },
    "./profile.repository": {
      "types": "./src/profile.repository.ts",
      "node": "./dist/profile.repository.js",
      "default": "./src/profile.repository.ts"
    },
    "./profile.schema": {
      "types": "./src/profile.schema.ts",
      "node": "./dist/profile.schema.js",
      "default": "./src/profile.schema.ts"
    },
    "./vocab": {
      "types": "./src/vocab/index.ts",
      "node": "./dist/vocab/index.js",
      "default": "./src/vocab/index.ts"
    },
    "./vocab/sidecar": {
      "types": "./src/vocab/sidecar.vocab.ts",
      "node": "./dist/vocab/sidecar.vocab.js",
      "default": "./src/vocab/sidecar.vocab.ts"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json && node scripts/fix-dist-esm.mjs",
    "lint": "echo \"lint not configured\"",
    "pack:release": "node scripts/pack-release.mjs",
    "sync:discovery:vercel": "node --experimental-strip-types scripts/sync-discovery-vercel.ts",
    "test": "vitest run",
    "test:ci": "vitest run tests/ai-config.test.ts tests/ai-runtime-schema.test.ts tests/client.test.ts tests/contracts-chat-contact.contract.test.ts tests/discovery-vercel.test.ts tests/discovery.test.ts tests/profile.test.ts tests/repository.test.ts tests/resource-utils.test.ts tests/session-schema.test.ts tests/sidecar-events.contract.test.ts tests/resource-schema.test.ts",
    "test:pod": "dotenv -e ../linx-models/.env -- vitest run tests/pod.integration.test.ts"
  },
  "dependencies": {
    "@comunica/query-sparql-solid": "^4.0.2",
    "@inrupt/vocab-common-rdf": "^1.0.5",
    "drizzle-orm": "^0.32.0",
    "n3": "^1.26.0",
    "@undefineds.co/drizzle-solid": "^0.3.12",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "dotenv-cli": "^7.3.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "packageManager": "yarn@1.22.22"
}
